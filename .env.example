# Telegram Bot API
BOT_TOKEN=replace_with_bot_token
BOT_USERNAME=replace_without_at_symbol

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/telegram_manager?authSource=admin&retryWrites=true&w=majority

# Telegram user-account API credentials
API_ID=replace_with_numeric_api_id
API_HASH=replace_with_api_hash

# 32-byte AES-256 key encoded as 64 hexadecimal characters
SESSION_ENCRYPTION_KEY=replace_with_64_hex_chars

# Comma-separated Telegram numeric IDs with admin access
ADMIN_IDS=123456789

# Optional
SUPPORT_URL=https://t.me/your_support
NODE_ENV=production
LOG_LEVEL=info
MAX_REPLY_LENGTH=4096
BROADCAST_DELAY_MS=40
