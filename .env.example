# Telegram Bot API
BOT_TOKEN=
BOT_USERNAME=

# MongoDB
MONGODB_URI=

# 32-byte AES-256 key encoded as 64 hexadecimal characters
SESSION_ENCRYPTION_KEY=

# Comma-separated Telegram user IDs allowed to use /admin
ADMIN_IDS=

# Optional support link
SUPPORT_URL=

# Runtime
NODE_ENV=production
LOG_LEVEL=info

# Campaign safety defaults
DEFAULT_SEND_DELAY_MS=3000
MAX_CAMPAIGN_RECIPIENTS=100
MAX_MESSAGE_LENGTH=4096
REQUIRE_RECIPIENT_CONSENT=true
REQUIRE_GROUP_POST_PERMISSION=true

# Referral
DEFAULT_REFERRAL_PERCENT=10
